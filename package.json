{
  "name": "shiftledger",
  "version": "0.1.0",
  "description": "An offline-first shift and pay ledger. Your hours stay in your browser.",
  "license": "Apache-2.0",
  "author": "Louis Boddie",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.0",
    "globals": "^16.5.0",
    "playwright": "1.63.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
